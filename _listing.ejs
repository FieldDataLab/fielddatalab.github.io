<%
  // Hand the listing data to assets/listing.js, which builds the page
  const kw = k => Array.isArray(k) ? k.join(', ') : (k || '');
  const who = a => [].concat(a || []).map(x => typeof x === 'string' ? x : (x.name && (x.name.literal || x.name)) || '').filter(Boolean).join(', ');
  const data = items.map(i => ({
    id: i['article-id'] || '',
    title: i.title || '',
    date: String(i.date || '').slice(0, 10),
    href: i.outputHref || i.path,
    author: who(i.author),
    sport: i.sport || '',
    tags: i.categories || [],
    abs: i.abstract || i.description || '',
    kw: kw(i.keywords),
    mins: parseInt(i['reading-time'], 10) || 1
  }));
%>
```{=html}
